    </g>`,
  crest: `
    <path d="M62 58 h76 v42 q0 34 -38 50 q-38 -16 -38 -50 Z" fill="${colorAlt}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/>
    <path d="M56 108 h88 l-10 16 h-68 Z" fill="${white}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/>
    <text x="100" y="120" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="700" font-size="15" letter-spacing="1" fill="${ink}">FINE</text>`,
  clock: `
    <circle cx="100" cy="100" r="46" fill="${white}" stroke="${ink}" stroke-width="4"/>
    <g stroke="${ink}" stroke-width="4" stroke-linecap="round">
      <line x1="100" y1="100" x2="100" y2="70"/>
      <line x1="100" y1="100" x2="78" y2="108"/>
    </g>
    <circle cx="100" cy="100" r="5" fill="${colorAlt}" stroke="${ink}" stroke-width="2.5"/>
    <circle cx="100" cy="60" r="2.5" fill="${ink}"/>
    <circle cx="140" cy="100" r="2.5" fill="${ink}"/>
    <circle cx="100" cy="140" r="2.5" fill="${ink}"/>
    <circle cx="60" cy="100" r="2.5" fill="${ink}"/>`,
  quay: `
    <!-- postcard border -->
    <rect x="42" y="52" width="116" height="96" rx="7" fill="none" stroke="${colorAlt}" stroke-width="3.5"/>
    <rect x="51" y="61" width="98" height="78" rx="3" fill="none" stroke="${colorAlt}" stroke-width="1.5" stroke-dasharray="3 4" opacity="0.85"/>
    <!-- moon -->
    <circle cx="68" cy="80" r="8" fill="${colorAlt}"/>
    <!-- city lights on the far shore -->
    <g fill="${colorAlt}">
      <circle cx="86" cy="98" r="2"/><circle cx="98" cy="95" r="2"/><circle cx="110" cy="97" r="2"/>
      <circle cx="122" cy="95" r="2"/><circle cx="134" cy="98" r="2"/>
    </g>
    <line x1="55" y1="104" x2="145" y2="104" stroke="${colorAlt}" stroke-width="1.5" opacity="0.6"/>
    <!-- ferry silhouette -->
    <g fill="${ink}" stroke="${ink}" stroke-width="1" stroke-linejoin="round">
      <path d="M72 118 h36 l-5 11 h-26 Z"/>
      <rect x="80" y="109" width="20" height="10"/>
      <rect x="84" y="112" width="4" height="4" fill="${colorAlt}" stroke="none"/>
      <rect x="92" y="112" width="4" height="4" fill="${colorAlt}" stroke="none"/>
    </g>
    <!-- water reflections -->
    <g stroke="${colorAlt}" stroke-width="2" stroke-linecap="round" opacity="0.8">
      <line x1="66" y1="130" x2="86" y2="130"/>
      <line x1="98" y1="135" x2="128" y2="135"/>
      <line x1="78" y1="140" x2="104" y2="140"/>
    </g>
    <!-- stamp + postmark -->
    <rect x="124" y="60" width="22" height="26" rx="1.5" fill="${colorAlt}" stroke="${ink}" stroke-width="1.5"/>
    <circle cx="135" cy="73" r="5" fill="none" stroke="${ink}" stroke-width="1.5"/>
    <path d="M116 66 a15 15 0 0 1 0 14" fill="none" stroke="${ink}" stroke-width="1.5" opacity="0.9"/>`,
  merlion: `
    <g stroke="${ink}" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
      <!-- body -->
      <path d="M82 92 C76 118 82 138 100 145 C118 138 124 118 118 92 Z" fill="${colorAlt}"/>
      <!-- fish tail -->
      <path d="M100 138 l-20 22 l20 -8 l20 8 Z" fill="${colorAlt}"/>
      <path d="M100 146 v10" fill="none" stroke-width="2.5"/>
      <!-- front paws -->
      <ellipse cx="86" cy="121" rx="7" ry="5" fill="${colorAlt}"/>
      <ellipse cx="114" cy="121" rx="7" ry="5" fill="${colorAlt}"/>
      <!-- mane -->
      <g fill="${colorAlt}">
        <circle cx="76" cy="52" r="8"/><circle cx="100" cy="44" r="8"/><circle cx="124" cy="52" r="8"/>
        <circle cx="68" cy="70" r="8"/><circle cx="132" cy="70" r="8"/>
        <circle cx="78" cy="86" r="7"/><circle cx="122" cy="86" r="7"/>
      </g>
      <!-- head -->
      <circle cx="100" cy="66" r="23" fill="${colorAlt}"/>
      <!-- ears -->
      <circle cx="84" cy="49" r="6" fill="${colorAlt}"/>
      <circle cx="116" cy="49" r="6" fill="${colorAlt}"/>
      <!-- face -->
      <circle cx="92" cy="64" r="2.8" fill="${ink}"/>
      <circle cx="108" cy="64" r="2.8" fill="${ink}"/>
      <path d="M96 72 q4 4 8 0" fill="none"/>
      <path d="M100 66 v4" fill="none" stroke-width="2.5"/>
      <!-- scale lines -->
      <path d="M86 108 q14 -7 28 0 M88 122 q12 -6 24 0" fill="none" stroke-width="2.5"/>
    </g>
    <!-- water spout from mouth -->
    <path d="M116 72 q18 -2 22 -18" fill="none" stroke="${white}" stroke-width="4" stroke-linecap="round"/>
    <g fill="${white}"><circle cx="142" cy="50" r="3"/><circle cx="134" cy="43" r="2.4"/></g>`,
  expo: `
    <!-- mirror frame -->
    <circle cx="100" cy="98" r="46" fill="${colorAlt}" stroke="${ink}" stroke-width="3.5"/>
    <!-- glass -->
    <circle cx="100" cy="98" r="35" fill="${white}" stroke="${ink}" stroke-width="3"/>
    <!-- green reflection / tint -->
    <path d="M100 63 a35 35 0 0 1 33 47 a35 35 0 0 0 -33 -47 Z" fill="${color}" opacity="0.55"/>
    <ellipse cx="112" cy="112" rx="16" ry="22" fill="${color}" opacity="0.35" transform="rotate(18 112 112)"/>
    <!-- soft reflection highlights -->
    <path d="M84 80 q-9 20 5 40" fill="none" stroke="#ffffff" stroke-width="7" stroke-linecap="round" opacity="0.85"/>
    <path d="M92 78 q-5 14 3 28" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" opacity="0.7"/>
    <!-- ring-light dots -->
    <g fill="${colorAlt}" stroke="${ink}" stroke-width="1.5">
      <circle cx="100" cy="45" r="3"/><circle cx="131" cy="57" r="3"/><circle cx="146" cy="88" r="3"/>
      <circle cx="140" cy="120" r="3"/><circle cx="60" cy="120" r="3"/><circle cx="54" cy="88" r="3"/><circle cx="69" cy="57" r="3"/>
    </g>`,
  daiquiri: `
    <g stroke="${ink}" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round">
      <!-- coupe bowl -->
      <path d="M62 66 Q100 106 138 66 Z" fill="${colorAlt}"/>
      <ellipse cx="100" cy="66" rx="38" ry="7" fill="${colorAlt}"/>
      <!-- stem -->
      <line x1="100" y1="98" x2="100" y2="132"/>
      <!-- foot -->
      <path d="M80 134 q20 -11 40 0" fill="none"/>
      <!-- lime wedge on the rim -->
      <path d="M122 60 L140 55 A15 15 0 0 1 140 72 Z" fill="#4aa564"/>
      <path d="M129 58 L133 68 M136 56 L138 66" stroke="${ink}" stroke-width="1.4"/>
    </g>
    <!-- glass shine -->
    <path d="M74 68 q9 18 22 24" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round" opacity="0.7"/>`,
};

const icon = icons[art] ?? icons.book;
---

<svg
  class={`pin-art ${className}`}
  viewBox="0 0 200 200"
  role="img"
  aria-label={title}
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- gold rim -->
  <circle cx="100" cy="100" r="96" fill={gold} />
  <circle cx="100" cy="100" r="96" fill="none" stroke={goldDark} stroke-width="2" />
  <circle cx="100" cy="100" r="88" fill="none" stroke={goldDark} stroke-width="1.5" opacity="0.6" />
  <!-- enamel disc -->
  <circle cx="100" cy="100" r="86" fill={color} />
  <!-- icon -->
  <g set:html={icon} />
  <!-- gloss (opacity, not a gradient) -->
  <ellipse cx="72" cy="60" rx="34" ry="16" fill="#ffffff" opacity="0.14" transform="rotate(-24 72 60)" />
</svg>

<style>
  .pin-art {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 18px rgba(23, 22, 20, 0.18));
  }
</style>
