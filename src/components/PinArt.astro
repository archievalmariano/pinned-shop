---
// Renders an enamel-pin style illustration for a product entirely as SVG.
// One shared "pin frame" (gold rim + enamel disc + gloss) with a per-design
// icon drawn on top. Keeps the shop tactile with zero binary image assets.
interface Props {
  art: string;
  color: string;
  colorAlt: string;
  title?: string;
  class?: string;
}
const { art, color, colorAlt, title = '', class: className = '' } = Astro.props;
const ink = '#171614';
const gold = '#c9a24b';
const goldDark = '#a07d31';
const white = '#faf7f0';

// Each icon is drawn within roughly x/y 40–160 (centre 100,100).
const icons: Record<string, string> = {
  jeepney: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
      <rect x="46" y="78" width="108" height="42" rx="8" fill="${colorAlt}"/>
      <path d="M58 78 q42 -22 84 0" fill="${colorAlt}"/>
      <rect x="60" y="70" width="80" height="14" rx="4" fill="${white}"/>
      <line x1="86" y1="70" x2="86" y2="84"/>
      <line x1="114" y1="70" x2="114" y2="84"/>
      <rect x="54" y="94" width="16" height="14" rx="2" fill="${white}"/>
      <rect x="76" y="94" width="16" height="14" rx="2" fill="${white}"/>
      <rect x="108" y="94" width="38" height="14" rx="2" fill="${ink}"/>
      <circle cx="72" cy="126" r="12" fill="${ink}"/>
      <circle cx="128" cy="126" r="12" fill="${ink}"/>
      <circle cx="72" cy="126" r="4" fill="${white}"/>
      <circle cx="128" cy="126" r="4" fill="${white}"/>
    </g>`,
  'jeepney-dusk': `
    <circle cx="132" cy="74" r="22" fill="${colorAlt}"/>
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
      <rect x="46" y="84" width="108" height="40" rx="8" fill="${ink}"/>
      <path d="M58 84 q42 -20 84 0" fill="${ink}"/>
      <rect x="58" y="96" width="16" height="12" rx="2" fill="${colorAlt}"/>
      <rect x="80" y="96" width="16" height="12" rx="2" fill="${colorAlt}"/>
      <rect x="102" y="96" width="16" height="12" rx="2" fill="${colorAlt}"/>
      <circle cx="72" cy="128" r="11" fill="${ink}"/>
      <circle cx="128" cy="128" r="11" fill="${ink}"/>
      <circle cx="72" cy="128" r="3.5" fill="${white}"/>
      <circle cx="128" cy="128" r="3.5" fill="${white}"/>
    </g>`,
  window: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <rect x="58" y="48" width="60" height="88" rx="30" fill="${white}"/>
      <rect x="68" y="58" width="40" height="68" rx="20" fill="${colorAlt}"/>
      <circle cx="88" cy="80" r="9" fill="${white}"/>
      <path d="M118 96 L150 108 L150 118 L118 116 Z" fill="${colorAlt}"/>
    </g>`,
  doorhanger: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <path d="M74 44 h52 a10 10 0 0 1 10 10 v88 a10 10 0 0 1 -10 10 h-52 a10 10 0 0 1 -10 -10 v-88 a10 10 0 0 1 10 -10 Z" fill="${colorAlt}"/>
      <circle cx="100" cy="60" r="10" fill="${white}"/>
    </g>
    <text x="100" y="118" text-anchor="middle" font-family="Georgia, serif" font-style="italic" font-size="22" fill="${ink}">later</text>`,
  cup: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
      <rect x="66" y="62" width="68" height="14" rx="4" fill="${white}"/>
      <line x1="112" y1="62" x2="120" y2="40" />
      <path d="M72 78 L128 78 L120 142 a6 6 0 0 1 -6 5 L86 147 a6 6 0 0 1 -6 -5 Z" fill="${colorAlt}"/>
      <line x1="78" y1="98" x2="122" y2="98"/>
    </g>`,
  cassette: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <rect x="50" y="62" width="100" height="76" rx="8" fill="${ink}"/>
      <rect x="62" y="74" width="76" height="30" rx="4" fill="${white}"/>
      <circle cx="84" cy="118" r="12" fill="${colorAlt}"/>
      <circle cx="116" cy="118" r="12" fill="${colorAlt}"/>
      <circle cx="84" cy="118" r="4" fill="${ink}"/>
      <circle cx="116" cy="118" r="4" fill="${ink}"/>
    </g>
    <text x="100" y="94" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="700" font-size="16" fill="${ink}">B</text>`,
  camera: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <rect x="52" y="72" width="96" height="60" rx="8" fill="${colorAlt}"/>
      <rect x="106" y="60" width="26" height="14" rx="3" fill="${white}"/>
      <circle cx="100" cy="102" r="20" fill="${white}"/>
      <circle cx="100" cy="102" r="11" fill="${ink}"/>
      <circle cx="94" cy="96" r="3.5" fill="${white}"/>
      <rect x="62" y="80" width="12" height="8" rx="2" fill="${ink}"/>
    </g>`,
  seen: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <path d="M52 66 h64 a8 8 0 0 1 8 8 v22 a8 8 0 0 1 -8 8 H72 l-14 12 v-12 h-6 a8 8 0 0 1 -8 -8 V74 a8 8 0 0 1 8 -8 Z" fill="${white}"/>
    </g>
    <path d="M96 118 l8 8 l14 -16" fill="none" stroke="${colorAlt}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M108 118 l8 8 l14 -16" fill="none" stroke="${colorAlt}" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="84" y="92" text-anchor="middle" font-family="'Inter', sans-serif" font-weight="700" font-size="15" fill="${ink}">8:47</text>`,
  bubble: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <path d="M50 60 h100 a10 10 0 0 1 10 10 v40 a10 10 0 0 1 -10 10 H86 l-20 18 v-18 h-16 a10 10 0 0 1 -10 -10 V70 a10 10 0 0 1 10 -10 Z" fill="${colorAlt}"/>
      <circle cx="78" cy="90" r="6" fill="${white}"/>
      <circle cx="100" cy="90" r="6" fill="${white}"/>
      <circle cx="122" cy="90" r="6" fill="${white}"/>
    </g>`,
  moon: `
    <path d="M126 56 a44 44 0 1 0 0 88 a34 34 0 0 1 0 -88 Z" fill="${colorAlt}" stroke="${ink}" stroke-width="4" stroke-linejoin="round"/>
    <g fill="${white}" stroke="${ink}" stroke-width="2.5">
      <path d="M74 66 l3 7 l7 3 l-7 3 l-3 7 l-3 -7 l-7 -3 l7 -3 Z"/>
      <path d="M62 104 l2.5 6 l6 2.5 l-6 2.5 l-2.5 6 l-2.5 -6 l-6 -2.5 l6 -2.5 Z"/>
    </g>`,
  book: `
    <g stroke="${ink}" stroke-width="4" stroke-linejoin="round">
      <path d="M100 70 C86 60 66 60 54 66 V132 C66 126 86 126 100 136 Z" fill="${white}"/>
