---
import { footerNav, site } from '../data/site';
import { link } from '../lib/link';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={link('/')} class="footer-word">Pinned</a>
      <p class="footer-thought">{site.thought}</p>
    </div>

    <div class="footer-cols">
      {footerNav.map((col) => (
        <nav class="footer-col" aria-label={col.title}>
          <h2 class="footer-heading">{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li><a href={link(l.href)} class="footer-link">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="disclosure">{site.disclosure}</p>
    <p class="copyright">© {year} {site.name} · {site.domain}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hair);
    margin-top: var(--sp-7);
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--sp-5);
    padding-block: var(--sp-6) var(--sp-5);
  }
  .footer-word {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    display: inline-block;
  }
  .footer-thought {
    font-size: var(--step-0);
    margin-top: var(--sp-2);
    max-width: 26ch;
    color: var(--ink-soft);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }
  .footer-heading {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-faint);
    margin-bottom: var(--sp-2);
  }
  .footer-col li {
    margin-bottom: 0.45rem;
  }
  .footer-link {
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .footer-link:hover {
    color: var(--ink);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3);
    align-items: baseline;
    padding-block: var(--sp-4);
    border-top: 1px solid var(--hair);
  }
  .disclosure {
    font-size: var(--step--1);
    color: var(--ink-faint);
    max-width: 60ch;
  }
  .copyright {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  @media (max-width: 760px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }
    .footer-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
