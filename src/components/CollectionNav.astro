---
import { collections } from '../data/collections';
import { productsInCollection } from '../data/products';
import { link } from '../lib/link';
interface Props {
  heading?: string;
}
const { heading } = Astro.props;
const counts = Object.fromEntries(
  collections.map((c) => [c.slug, productsInCollection(c.slug).length]),
);
---

<div class="coll-nav" id="collections">
  {heading && <h2 class="coll-heading display-3">{heading}</h2>}
  <ul class="coll-grid">
    {collections.map((c) => (
      <li>
        <a class="coll-tile" href={link(`/collections/${c.slug}`)} style={`--accent:${c.accent}`}>
          <span class="coll-tile-head">
            <span class="coll-tile-dot" aria-hidden="true"></span>
            <span class="coll-tile-name">{c.name}</span>
          </span>
          <span class="coll-tile-blurb">{c.blurb}</span>
          <span class="coll-tile-count">{counts[c.slug]} pins</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .coll-heading {
    margin-bottom: var(--sp-4);
  }
  .coll-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-3);
  }
  .coll-tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: var(--sp-4) var(--sp-3);
    background: var(--card);
    border: 1px solid var(--hair);
    border-radius: var(--r-md);
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
  }
  .coll-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--hair-strong);
  }
  .coll-tile-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .coll-tile-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
  }
  .coll-tile-name {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1;
  }
  .coll-tile-blurb {
    font-size: var(--step--1);
    color: var(--ink-soft);
    line-height: 1.4;
    flex: 1;
  }
  .coll-tile-count {
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
  @media (max-width: 1000px) {
    .coll-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .coll-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
