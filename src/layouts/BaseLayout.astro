---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { site } from '../data/site';
import { link } from '../lib/link';

interface Props {
  title?: string;
  description?: string;
  /** Relative path, used to build canonical + OG URLs. */
  path?: string;
  /** Optional JSON-LD object injected into <head>. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const {
  title,
  description = site.description,
  path = '/',
  jsonLd,
  ogType = 'website',
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.thought}`;
// Every POC URL uses the deployed directory form so the canonical resolves to
// the same URL that GitHub Pages serves instead of a redirecting variant.
const linkedPath = link(path);
const canonicalPath = linkedPath.endsWith('/') ? linkedPath : `${linkedPath}/`;
const canonical = new URL(canonicalPath, Astro.site ?? site.url).toString();
const ogImage = new URL(link('/og.png'), Astro.site ?? site.url).toString();
const siteRoot = new URL(link('/'), Astro.site ?? site.url).toString();

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: siteRoot,
  slogan: site.thought,
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Manila',
    addressCountry: 'PH',
  },
};
const lds = [orgLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4efe4" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {lds.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CartDrawer />
  </body>
</html>
